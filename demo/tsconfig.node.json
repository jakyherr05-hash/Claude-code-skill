{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "allowImportingTsExtensions": false
  },
  "include": [
    "tests",
    "lab",
    "playwright.config.ts",
    "vite.config.ts"
  ]
}